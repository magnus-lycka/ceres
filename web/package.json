{
  "name": "ceres-web",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build --logLevel warn",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src *.json *.ts *.js",
    "format:check": "prettier --check src *.json *.ts *.js",
    "test": "vitest run",
    "test:rules": "vitest run --project rules",
    "coverage": "vitest run --coverage"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^3.0.0"
  },
  "dependencies": {
    "@svgrid/grid": "^2.6.2",
    "idb-keyval": "^6.3.0",
    "zod": "^4.4.3"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "cookie": "^0.7.0"
  }
}
